{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Strict",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "number": { "type": "number" },
    "negNumber": { "type": "number" },
    "maxNumber": { "type": "number" },
    "string": { "type": "string" },
    "longString": { "type": "string" },
    "boolean": { "type": "boolean" },
    "deeplyNested": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "foo": { "type": "string" },
        "num": { "type": "number" },
        "bool": { "type": "boolean" }
      },
      "required": ["foo", "num", "bool"]
    }
  },
  "required": [
    "number",
    "negNumber",
    "maxNumber",
    "string",
    "longString",
    "boolean",
    "deeplyNested"
  ]
}
